.DS_Store
Thumbs.db
*.swp
*~
.idea/

# Dependencies
node_modules/

# VS Code launch and tasks are tracked intentionally
# .vscode/

# Runtime / bind-mounted data (Docker stacks)
data/
media/
.data/

# .NET build outputs
**/bin/
**/obj/

# Secrets and local env (never commit passwords or generated keys)
secrets/
lab.config.json
.env
.env.*
!.env.example

# Optional per-machine Compose overlays (merged explicitly by scripts/common.sh).
# With `docker compose -f …`, Compose does NOT auto-merge docker-compose.override.yml.
docker-compose.override.yml
docker-compose.*.override.yml

# Logs and temp files
*.log
*.tmp

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Generated Control Center UI + runtime configs (seeded by scripts/ensure-wwwroot.sh)
control-center/wwwroot/
control-center/dist/
control-center/node_modules/
