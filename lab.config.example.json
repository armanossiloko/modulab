{
  "_comment": "Only hand-edited config (or via Control Center Lab Settings). Run: python3 scripts/lab.py render-config. \"$generate\" becomes a random secret on first render. Secrets: \"$secret:filename\" under secrets/.",
  "lab": {
    "domain": "network.lan",
    "hostIp": "",
    "timezone": "Europe/Berlin",
    "postgresUser": "modulab",
    "postgresPassword": "$generate",
    "postgresDb": "modulab",
    "piholePassword": "$generate",
    "picoshareAdminSecret": "$generate",
    "futoNotesPassword": "$generate",
    "searxngSecret": "$generate",
    "mediacmsAdminPassword": "$generate",
    "mediacmsSecretKey": "$generate",
    "enableLanHttps": true,
    "protectedApps": []
  },
  "caddy": {
    "ENABLE_LAN_PROXY": true
  },
  "futo-notes": {
    "FUTO_NOTES_PORT": 3005
  },
  "searxng": {
    "SEARXNG_PORT": 8080,
    "SEARXNG_BASE_URL": "http://localhost:8080/"
  },
  "enabled": [
    "control-center",
    "postgres",
    "caddy"
  ]
}
