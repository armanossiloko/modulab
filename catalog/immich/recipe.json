{
  "id": "immich",
  "name": "Immich",
  "description": "Photos and videos (uses shared Postgres + Redis)",
  "category": "media",
  "compose": "docker-compose.immich.yml",
  "port": 2283,
  "installable": true,
  "dependsOn": ["postgres", "redis"],
  "database": "immich",
  "databaseNeedsVector": true,
  "proxy": { "host": "immich", "port": 2283 },
  "dns": ["immich"],
  "defaults": {
    "IMMICH_VERSION": "v3",
    "IMMICH_DB_NAME": "immich"
  },
  "fields": [
    {
      "key": "UPLOAD_LOCATION",
      "label": "Photo library path (host)",
      "type": "string",
      "default": "data/immich/library",
      "required": false
    },
    {
      "key": "IMMICH_VERSION",
      "label": "Immich version tag",
      "type": "string",
      "default": "v3",
      "required": false
    }
  ]
}
