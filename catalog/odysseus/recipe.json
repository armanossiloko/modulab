{
  "id": "odysseus",
  "name": "Odysseus",
  "description": "AI workspace (includes SearXNG + ntfy)",
  "category": "productivity",
  "compose": "docker-compose.odysseus.yml",
  "port": 7000,
  "installable": true,
  "dependsOn": [],
  "proxy": {
    "host": "odysseus",
    "port": 7000
  },
  "dns": [
    "odysseus",
    "searxng",
    "ntfy"
  ],
  "extraServices": [
    {
      "label": "searxng",
      "name": "SearXNG",
      "description": "Private search",
      "category": "tools",
      "port": 8080,
      "proxy": {
        "host": "searxng",
        "port": 8080
      }
    },
    {
      "label": "ntfy",
      "name": "ntfy",
      "description": "Push notifications",
      "category": "tools",
      "port": 8091,
      "proxy": {
        "host": "ntfy",
        "port": 8091
      }
    }
  ],
  "defaults": {
    "LLM_HOST": "localhost",
    "SEARXNG_INSTANCE": "http://localhost:8080"
  },
  "fields": [
    {
      "key": "LLM_HOST",
      "label": "LLM host",
      "type": "string",
      "default": "localhost",
      "required": false
    }
  ]
}
