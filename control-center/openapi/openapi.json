  "components": {
    "schemas": {
      "ApiMessage": {
        "required": [
          "message"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "BookmarkGroupDto": {
        "required": [
          "title",
          "color",
          "links"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "color": {
            "type": [
              "null",
              "string"
            ]
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookmarkLinkDto"
            }
          }
        }
      },
      "BookmarkLinkDto": {
        "required": [
          "title",
          "url",
          "domain"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "domain": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CatalogItem": {
        "required": [
          "id",
          "name",
          "description",
          "category",
          "port",
          "path",
          "installable",
          "core",
          "dependsOn",
          "fields",
          "enabled",
          "running",
          "status"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "port": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "path": {
            "type": [
              "null",
              "string"
            ]
          },
          "installable": {
            "type": "boolean"
          },
          "core": {
            "type": "boolean"
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecipeField"
            }
          },
          "enabled": {
            "type": "boolean"
          },
          "running": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "CatalogResponse": {
        "required": [
          "apps"
        ],
        "type": "object",
        "properties": {
          "apps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogItem"
            }
          }
        }
      },
      "FeedItem": {
        "required": [
          "title",
          "url",
          "meta",
          "thumb"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "meta": {
            "type": "string"
          },
          "thumb": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "FeedResponse": {
        "required": [
          "source",
          "channel",
          "items"
        ],
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeedItem"
            }
          }
        }
      },
      "HealthResponse": {
        "required": [
          "status",
          "labRoot"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "labRoot": {
            "type": "string"
          }
        }
      },
      "ImportBookmarksRequest": {
        "required": [
          "groups",
          "mergeByTitle"
        ],
        "type": "object",
        "properties": {
          "groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookmarkGroupDto"
            }
          },
          "mergeByTitle": {
            "type": [
              "null",
              "boolean"
            ]
          }
        }
      },
      "InstallRequest": {
        "required": [
          "config"
        ],
        "type": "object",
        "properties": {
          "config": {
            "type": [
              "null",
              "object"
            ]
          }
        }
      },
      "JsonElement": { },
      "JsonNode": { },
      "RecipeField": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "fromLab": {
            "type": [
              "null",
              "string"
            ]
          },
          "default": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JsonElement"
              }
            ]
          }
        }
      },
      "ReplaceBookmarksRequest": {
        "required": [
          "groups",
          "showInstalledApps"
        ],
        "type": "object",
        "properties": {
          "groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookmarkGroupDto"
            }
          },
          "showInstalledApps": {
            "type": [
              "null",
              "boolean"
            ]
          }
        }
      },
      "WeatherResponse": {
        "required": [
          "label",
          "temperatureC",
          "weatherCode",
          "summary",
          "windKmh",
          "humidity"
        ],
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "temperatureC": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "weatherCode": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "summary": {
            "type": "string"
          },
          "windKmh": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "humidity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      }
    },
    "securitySchemes": {
      "LabKey": {
        "type": "apiKey",
        "description": "Optional shared secret from lab.controlCenterApiKey / CONTROL_CENTER_API_KEY.",
        "name": "X-Lab-Key",
        "in": "header"
      }
    }
  },
  "tags": [
    {
      "name": "System"
    },
    {
      "name": "Feeds"
    },
    {
      "name": "Widgets"
    },
    {
      "name": "Apps"
    },
    {
      "name": "Dashboard"
    }
  ]
}