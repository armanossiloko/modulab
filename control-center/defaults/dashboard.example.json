{
  "_comment": "Tracked template in control-center/defaults/. Copied to wwwroot/dashboard.json on setup if missing. Hard-refresh Control Center after changes. Unknown keys are ignored.",
  "title": "Modulab",
  "search": {
    "engine": "https://duckduckgo.com/?q=%s",
    "placeholder": "Search stacks or the web…",
    "libraryPlaceholder": "Filter library…"
  },
  "theme": {
    "accent": "#d9a441"
  },
  "sidebar": {
    "showInstalledApps": true,
    "bookmarks": [
      {
        "_comment": "Prefer Edit shortcuts in the Control Center UI to regroup/reorder. Import bookmarks from a browser HTML export also works.",
        "title": "Personal",
        "color": "#5b9bd9",
        "links": [
          { "title": "Example", "url": "https://example.com", "domain": "example.com" }
        ]
      }
    ]
  },
  "widgets": {
    "stacks": { "enabled": true, "title": "Lab stacks" },
    "community": {
      "enabled": true,
      "title": "Community",
      "communities": ["selfhosted", "homelab"],
      "limit": 6
    },
    "hackerNews": { "enabled": true, "title": "Hacker News", "limit": 8 },
    "media": {
      "enabled": true,
      "title": "Media",
      "emptyHint": "Install a media app from the Library."
    },
    "clock": { "enabled": true },
    "weather": {
      "enabled": false,
      "title": "Weather",
      "label": "Your city",
      "latitude": 0,
      "longitude": 0
    },
    "yearProgress": { "enabled": true, "title": "Year progress" },
    "stackUsage": { "enabled": true, "title": "Stack usage" },
    "network": { "enabled": true, "title": "Network" },
    "nowRunning": { "enabled": true, "title": "Now running" },
    "calendar": { "enabled": true }
  },
  "layout": {
    "center": ["stacks", "community", "hackerNews", "media"],
    "right": ["clock", "weather", "yearProgress", "stackUsage", "network", "nowRunning", "calendar"]
  },
  "pages": [
    {
      "_comment": "Default mirrors pre-Angular home: 2-col main (.home-grid) + ~260px right rail. Omit pages to auto-migrate from layout.",
      "id": "home",
      "title": "Home",
      "items": [
        { "id": "stacks-0-0", "type": "stacks", "x": 0, "y": 0, "w": 5, "h": 4 },
        { "id": "community-5-0", "type": "community", "x": 5, "y": 0, "w": 4, "h": 4 },
        { "id": "hackerNews-0-4", "type": "hackerNews", "x": 0, "y": 4, "w": 5, "h": 4 },
        { "id": "media-5-4", "type": "media", "x": 5, "y": 4, "w": 4, "h": 4 },
        { "id": "clock-9-0", "type": "clock", "x": 9, "y": 0, "w": 3, "h": 2 },
        { "id": "weather-9-2", "type": "weather", "x": 9, "y": 2, "w": 3, "h": 2 },
        { "id": "yearProgress-9-4", "type": "yearProgress", "x": 9, "y": 4, "w": 3, "h": 2 },
        { "id": "stackUsage-9-6", "type": "stackUsage", "x": 9, "y": 6, "w": 3, "h": 2 },
        { "id": "network-9-8", "type": "network", "x": 9, "y": 8, "w": 3, "h": 2 },
        { "id": "nowRunning-9-10", "type": "nowRunning", "x": 9, "y": 10, "w": 3, "h": 2 },
        { "id": "calendar-9-12", "type": "calendar", "x": 9, "y": 12, "w": 3, "h": 3 }
      ]
    }
  ]
}
